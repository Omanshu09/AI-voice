# Required for AI replies. Without it the app runs on the built-in local engine.
GEMINI_API_KEY=
# Optional. Verify a free-tier model in Google AI Studio, or run: npm run check:gemini
GEMINI_MODEL=gemini-flash-latest
# Optional second model tried if the first is unavailable (404/400)
GEMINI_FALLBACK_MODEL=
# Comma-separated list of allowed frontend origins. Supports "https://*.vercel.app".
FRONTEND_ORIGIN=http://localhost:5173
# Render sets PORT automatically
PORT=8080
